{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://schema.nethserver.org/mail/add-owned-addresses-input.json",
    "title": "add-owned-addresses input",
    "description": "Create addresses owned by the calling module. All of them are created, or none.",
    "examples": [
        {
            "domain": "example.org",
            "addresses": [
                {
                    "local": "mylist",
                    "destination": "mylist@sympa1.invalid"
                },
                {
                    "local": "mylist-request",
                    "destination": "mylist-request@sympa1.invalid"
                }
            ]
        }
    ],
    "type": "object",
    "required": [
        "domain",
        "addresses"
    ],
    "additionalProperties": false,
    "properties": {
        "domain": {
            "type": "string",
            "title": "Mail domain",
            "minLength": 1
        },
        "addresses": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "local",
                    "destination"
                ],
                "additionalProperties": false,
                "properties": {
                    "local": {
                        "type": "string",
                        "title": "Address local part",
                        "minLength": 1,
                        "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9._+-]*[a-zA-Z0-9])?$"
                    },
                    "destination": {
                        "type": "string",
                        "format": "email",
                        "title": "External destination"
                    }
                }
            }
        },
        "description": {
            "type": "string",
            "title": "Description of the addresses"
        },
        "owner": {
            "type": "string",
            "title": "Owner module UUID",
            "description": "Required when the caller is not a module. A module caller always owns its addresses.",
            "minLength": 1
        }
    }
}
