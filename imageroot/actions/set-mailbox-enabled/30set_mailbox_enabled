import json
import sys
import mail

request = json.load(sys.stdin)

# Postfix and Dovecot read the disabled_mailboxes table at each lookup:
# the change applies without reloading them.
sdb = mail.pcdb_connect()
with sdb:
    mail.set_mailbox_enabled(sdb, request['user'], request['enabled'], request.get('udesc', ''))
