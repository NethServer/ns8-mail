#
# aliases -- virtual alias map
#
# Expand an address to multiple user/group destinations.
# Wildcard address expansion has lower priority than
# exact-domain match, and they are mutually-exclusive
# (see NOT EXISTS clause).
#
# Public mailbox destinations ("vmail+" prefix) are returned as quoted
# strings: the mailbox name can contain spaces and commas, that
# otherwise separate addresses in the lookup result. The address local
# part is matched also in its quoted form, as Postfix looks up an
# address like "public mailbox"@example.org with the quotes. Like the
# alocal column, the quoted form is compared case-insensitively, as
# Postfix lowercases the lookup key.
#

dbpath = /srv/pcdb.sqlite
query =
  SELECT CASE WHEN substr(dest, 1, 6) = 'vmail+'
    THEN '"' || replace(replace(dest, '\', '\\'), '"', '\"') || '"'
    ELSE dest END
  FROM destmap
  WHERE (alocal = '%u' OR '"' || alocal || '"' = '%u' COLLATE NOCASE)
    AND domain = '%d'
    AND '%d' IN (SELECT domain FROM domains)
  UNION SELECT CASE WHEN substr(dest, 1, 6) = 'vmail+'
    THEN '"' || replace(replace(dest, '\', '\\'), '"', '\"') || '"'
    ELSE dest END
  FROM destmap
  WHERE (alocal = '%u' OR '"' || alocal || '"' = '%u' COLLATE NOCASE)
    AND domain = '*'
    AND '%d' IN (SELECT domain FROM domains)
    AND NOT EXISTS (
      SELECT 1 FROM destmap
      WHERE (alocal = '%u' OR '"' || alocal || '"' = '%u' COLLATE NOCASE)
        AND domain = '%d'
        AND '%d' IN (SELECT domain FROM domains)
    )
