#
# userforwards -- expand user name to their forward addresses
#
# Public mailbox destinations are quoted, like in aliases.cf
# Disabled mailboxes have no forwards
#

dbpath = /srv/pcdb.sqlite
query =
    SELECT CASE WHEN substr(dest, 1, 6) = 'vmail+'
      THEN '"' || replace(replace(dest, '\', '\\'), '"', '\"') || '"'
      ELSE dest END
    FROM userforwards
    WHERE user = '%u'
      AND lower(user) NOT IN (${tmpl_disabled_users_sql})
domain = ${tmpl_vdomain}
